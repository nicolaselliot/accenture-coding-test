<?xml version="1.0" encoding="utf-8"?>
<!--
  In plain `mipmap/`, not `mipmap-anydpi-v26/`: that qualifier exists so an
  adaptive icon can coexist with PNGs for pre-26 devices, and minSdk 26 means
  there are none to coexist with.

  The monochrome layer reuses the foreground because the system takes only its
  shape and applies its own colour — which is what makes the Android 13+ themed
  icon follow the same dynamic colour the app's theme already honours.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
