# =================================================================================================
# Gradle
# =================================================================================================
.gradle/
build/
captures/
.gradletasknamecache
# The wrapper JAR is committed because Gradle requires it to bootstrap. Note what is and is not
# verified: distributionSha256Sum in gradle-wrapper.properties pins the Gradle *distribution*,
# not this JAR. The JAR itself is unverified until PR2 adds gradle/actions/wrapper-validation.
!gradle/wrapper/gradle-wrapper.jar

